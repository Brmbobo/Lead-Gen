# Lead-Gen Environment Configuration
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!

# =============================================================================
# REQUIRED API KEYS
# =============================================================================

# Google Places API (New) - for lead scraping
# Get from: https://console.cloud.google.com/apis/credentials
GOOGLE_PLACES_API_KEY=your_google_places_api_key_here

# OpenAI API - for AI-powered message generation
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Google Service Account - for Google Sheets export
# Download JSON from: https://console.cloud.google.com/iam-admin/serviceaccounts
# Store the file path or base64 encoded content
GOOGLE_SERVICE_ACCOUNT_PATH=/path/to/service-account.json
# OR use base64 encoded JSON:
# GOOGLE_SERVICE_ACCOUNT_BASE64=eyJ0eXBlIjoi...

# =============================================================================
# OPTIONAL API KEYS
# =============================================================================

# Hunter.io API - for email enrichment (optional)
# Get from: https://hunter.io/api_keys
HUNTER_API_KEY=your_hunter_api_key_here

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================

# Environment: development | staging | production
ENVIRONMENT=development

# Log level: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# Enable structured JSON logging (recommended for production)
LOG_JSON=false

# =============================================================================
# RATE LIMITING (requests per minute)
# =============================================================================

RATE_LIMIT_GOOGLE_PLACES=60
RATE_LIMIT_OPENAI=60
RATE_LIMIT_HUNTER=30

# =============================================================================
# SECURITY SETTINGS
# =============================================================================

# Secret backend: env | vault | aws_secrets_manager
SECRET_BACKEND=env

# HashiCorp Vault (if SECRET_BACKEND=vault)
VAULT_ADDR=https://vault.example.com:8200
VAULT_TOKEN=your_vault_token
VAULT_MOUNT_POINT=secret
VAULT_SECRET_PATH=lead-gen/api-keys

# AWS Secrets Manager (if SECRET_BACKEND=aws_secrets_manager)
AWS_REGION=eu-central-1
AWS_SECRET_NAME=lead-gen/api-keys

# =============================================================================
# GDPR SETTINGS
# =============================================================================

# Data retention period in days (default: 90)
GDPR_RETENTION_DAYS=90

# Legal basis for processing: legitimate_interest | consent
GDPR_LEGAL_BASIS=legitimate_interest

# Data Protection Officer contact
GDPR_DPO_EMAIL=dpo@your-company.com

# =============================================================================
# GOOGLE SHEETS SETTINGS
# =============================================================================

# Default spreadsheet ID for exports
GOOGLE_SHEETS_SPREADSHEET_ID=your_spreadsheet_id_here

# Default worksheet name
GOOGLE_SHEETS_WORKSHEET_NAME=Leads

# =============================================================================
# OPENAI SETTINGS
# =============================================================================

# Model to use for message generation
OPENAI_MODEL=gpt-4o-mini

# Maximum tokens for generated messages
OPENAI_MAX_TOKENS=500

# Temperature for generation (0.0-2.0)
OPENAI_TEMPERATURE=0.7
